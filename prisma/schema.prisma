generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. WAFANYAKAZI (Admin, Reception, Mechanic)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // "Admin", "Reception", "Mechanic"
  jobs      Job[]    @relation("AssignedMechanic")
  createdAt DateTime @default(now())
}

// 2. WATEJA WETU
model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
}

// 3. MAGARI YA WATEJA
model Vehicle {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  make      String   // Mfano: Toyota
  model     String   // Mfano: Land Cruiser
  plate     String   @unique
  vin       String?
  jobs      Job[]
}

// 4. KAZI / BOOKINGS / MATENGENEZO (Hapa ndio workflow inapita)
model Job {
  id            String       @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id])
  serviceType   String
  description   String?      // Tatizo alilosema mteja (Kutoka kwenye booking form)
  status        String       // "Pending", "In Progress", "Waiting Parts", "Ready", "Collected"
  mechanicId    String?      // Fundi aliyekabidhiwa
  mechanic      User?        @relation("AssignedMechanic", fields: [mechanicId], references: [id])
  mechanicNotes String?      // Ugonjwa aliougundua fundi (Diagnosis)
  requestedParts String?     // Vifaa anavyoomba fundi kutoka stoo
  appointment   DateTime?    // Tarehe ya kuja
  invoice       Invoice?
  partsUsed     JobPart[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// 5. INVENTORY (Spare Parts zilizopo stoo)
model SparePart {
  id        String     @id @default(uuid())
  name      String
  category  String
  price     Float
  stock     Int
  jobs      JobPart[]
}

// 6. VIFAA VILIVYOTUMIKA KWENYE GARI HUSIKA (Kama Fundi kaagiza na vimetumika)
model JobPart {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  partId      String
  part        SparePart @relation(fields: [partId], references: [id])
  quantity    Int
  priceAtTime Float     // Bei ya wakati huo ili isibadilike kwenye invoice hata kama stoo ikipanda bei
}

// 7. INVOICES & MALIPO
model Invoice {
  id          String   @id @default(uuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  laborCost   Float    @default(0) // Pesa ya ufundi
  totalAmount Float    // Jumla (Labor + Parts)
  status      String   // "Unpaid", "Paid"
  createdAt   DateTime @default(now())
}

// 8. EMERGENCY SOS ALERTS
model SOSAlert {
  id          String   @id @default(uuid())
  name        String
  phone       String
  location    String   // Mahali alipokwama
  issue       String   // Shida ya gari
  status      String   @default("Active") // "Active" (Bado haijatatuliwa) au "Resolved" (Imetatuliwa)
  createdAt   DateTime @default(now())
}